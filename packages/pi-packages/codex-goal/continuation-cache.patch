diff --git a/test/continuation-cache.test.ts b/test/continuation-cache.test.ts
--- a/test/continuation-cache.test.ts
+++ b/test/continuation-cache.test.ts
@@ -0,0 +1,86 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { convertToLlm } from "@earendil-works/pi-coding-agent";
+
+import { compactContinuationPrompt } from "../src/prompts.ts";
+import { toQueuedGoalWorkSource, type QueuedGoalContextCarrier } from "../src/queued-goal-messages.ts";
+import {
+  assistantMessage,
+  createRuntimeHarness,
+  emitProviderContext,
+  emitQueuedTurnThroughContext,
+  goalCustomContextMessage,
+  queuedCustomMessage,
+} from "./support/runtime-harness.ts";
+
+function serializedProviderInput(messages: QueuedGoalContextCarrier[]): string[] {
+  return convertToLlm(messages.map((message) => {
+    const source = toQueuedGoalWorkSource(message);
+    assert.ok(source);
+    return source;
+  })).map((message) => JSON.stringify(message));
+}
+
+test("successive goal continuations preserve serialized provider input prefixes", async () => {
+  const harness = createRuntimeHarness();
+  await harness.runCommand("ship it");
+  const goal = harness.snapshot().goal;
+  assert.ok(goal);
+  const first = harness.sentMessages[0];
+  assert.ok(first);
+  const history = [queuedCustomMessage(first, 1)];
+  let previousInput = serializedProviderInput(history);
+
+  for (let turn = 1; turn <= 8; turn++) {
+    const previousHistory = structuredClone(history);
+    history.push(goalCustomContextMessage({
+      content: compactContinuationPrompt({
+        ...goal,
+        usage: { tokensUsed: turn * 1000, activeSeconds: turn * 60 },
+      }),
+      details: { kind: "continuation", goalId: goal.goalId },
+      timestamp: turn + 1,
+    }));
+    const results = await emitProviderContext(harness, history);
+    const projected = results[0]?.messages ?? history;
+    assert.deepEqual(projected.slice(0, previousHistory.length), previousHistory);
+    const nextInput = serializedProviderInput(projected);
+    assert.deepEqual(nextInput.slice(0, previousInput.length), previousInput);
+    previousInput = nextInput;
+  }
+});
+
+test("repeated reads and accounting do not refresh historical continuation snapshots", async () => {
+  const harness = createRuntimeHarness();
+  await harness.runCommand("ship it");
+  const queued = harness.sentMessages[0];
+  assert.ok(queued);
+  const history = [queuedCustomMessage(queued, 1)];
+  const previousInput = serializedProviderInput(history);
+  await emitQueuedTurnThroughContext(harness, history, 0);
+  await harness.runTool("get_goal", {});
+  await harness.emit("turn_end", {
+    type: "turn_end",
+    turnIndex: 0,
+    message: assistantMessage("toolUse", { input: 100, output: 10 }),
+    toolResults: [],
+  });
+  const results = await emitProviderContext(harness, history);
+  assert.deepEqual(serializedProviderInput(results[0]?.messages ?? history), previousInput);
+  assert.equal(harness.snapshot().goal?.usage.tokensUsed, 110);
+});
+
+test("pause and resume preserve the active goal's original history", async () => {
+  const harness = createRuntimeHarness();
+  await harness.runCommand("ship it");
+  const queued = harness.sentMessages[0];
+  assert.ok(queued);
+  const history = [queuedCustomMessage(queued, 1)];
+  const previousInput = serializedProviderInput(history);
+  await harness.runCommand("pause");
+  assert.equal(harness.snapshot().goal?.status, "paused");
+  await harness.runCommand("resume");
+  assert.equal(harness.snapshot().goal?.status, "active");
+  const results = await emitProviderContext(harness, history);
+  assert.deepEqual(serializedProviderInput(results[0]?.messages ?? history), previousInput);
+});
